# Compiled TypeScript output belongs in dist/ (ignored above), never beside
# src/. The build is esbuild → dist/ and tests run via tsx (no emit), but an
# ad-hoc `tsc <file>` or an editor "compile on save" can still emit artifacts
# next to the sources — ignore them so they can't be committed or clutter the
# working tree.
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map
# ...except hand-written source that lives under src/ (emitted artifacts have a
# sibling .ts; these do not). Add any new hand-written ambient .d.ts here:
!packages/core/src/__feedback/widget.js
!packages/orm/src/adapters/pg-types.d.ts

# Runtime artifacts — never commit. SQLite WAL/SHM sidecars (the .db itself is
# already ignored above) and the auto-generated JWT RSA keypair (.keys/ holds
# private.pem — a secret).
*.db-wal
*.db-shm
.keys/

# generated .d.ts for the exports map (regenerated by prepublishOnly)
types/
