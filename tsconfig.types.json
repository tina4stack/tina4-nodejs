{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "packages",
    "outDir": "types",
    "skipLibCheck": true,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["packages/*/src/**/*.ts"],
  "exclude": ["**/*.test.ts", "packages/*/dist"]
}
