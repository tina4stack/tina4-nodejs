{
  "name": "tina4-nodejs",
  "version": "3.13.91",
  "type": "module",
  "description": "Tina4 for Node.js/TypeScript - 54 built-in features, zero dependencies",
  "keywords": [
    "tina4",
    "framework",
    "web",
    "api",
    "orm",
    "graphql",
    "websocket",
    "typescript"
  ],
  "homepage": "https://tina4.com/nodejs",
  "repository": {
    "type": "git",
    "url": "https://github.com/tina4stack/tina4-nodejs.git"
  },
  "license": "MIT",
  "author": "Tina4 Team <info@tina4.com>",
  "workspaces": [
    "packages/*"
  ],
  "main": "packages/core/dist/index.js",
  "types": "packages/core/src/index.ts",
  "exports": {
    ".": {
      "types": "./packages/core/src/index.ts",
      "import": "./packages/core/dist/index.js",
      "default": "./packages/core/dist/index.js"
    },
    "./orm": {
      "types": "./packages/orm/src/index.ts",
      "import": "./packages/orm/dist/index.js",
      "default": "./packages/orm/dist/index.js"
    },
    "./swagger": {
      "types": "./packages/swagger/src/index.ts",
      "import": "./packages/swagger/dist/index.js",
      "default": "./packages/swagger/dist/index.js"
    },
    "./frond": {
      "types": "./packages/frond/src/engine.ts",
      "import": "./packages/frond/dist/index.js",
      "default": "./packages/frond/dist/index.js"
    }
  },
  "files": [
    "packages/frond/dist/**/*",
    "packages/swagger/dist/**/*",
    "packages/orm/dist/**/*",
    "packages/core/dist/**/*",
    "packages/cli/dist/**/*",
    "packages/core/src/**/*",
    "packages/core/public/**/*",
    "packages/core/templates/**/*",
    "packages/core/gallery/**/*",
    "packages/orm/src/**/*",
    "packages/swagger/src/**/*",
    "packages/frond/src/**/*",
    "packages/cli/src/**/*",
    "skills/**/*",
    "CLAUDE.md",
    "COMPARISON.md",
    "BENCHMARK_REPORT.md",
    "CARBONAH.md",
    "README.md"
  ],
  "bin": {
    "tina4nodejs": "packages/cli/dist/bin.js"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "clean": "rm -rf packages/*/dist",
    "pretest": "npm run build",
    "test": "tsx test/run-all.ts && npm run test:i18n",
    "test:i18n": "vitest run test/i18n.test.ts test/i18n-leaf-alias.test.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "mongodb": "^6.0.0",
    "pg": "^8.20.0",
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "mongodb": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9"
  }
}
